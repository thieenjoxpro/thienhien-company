# Mẫu cấu hình cho docker compose. Chép thành .env rồi sửa, hoặc chạy: node scripts/make-env.mjs
# (tự sinh mật khẩu ngẫu nhiên). File .env không được commit.

# Tên miền của site, không có https://. Chạy thử trên máy thì để localhost.
SITE_DOMAIN=localhost

# Mật khẩu PostgreSQL. Chỉ dùng chữ và số (nó nằm trong URL kết nối).
POSTGRES_PASSWORD=

# Tài khoản quản trị đầu tiên của /admin. Chỉ có tác dụng khi database chưa có tài khoản nào.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
